# ── Build-time (se hornean en el bundle — requieren rebuild al cambiar) ────────

# URL pública del backend API. Se usa en páginas Server Component y API routes.
# Local: http://localhost:8000 · Producción: https://api.consultatulinea.mx
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cloudflare Turnstile — clave PÚBLICA del sitio (visible en el browser).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=change-me

# ── Runtime (solo servidor — nunca llegan al browser) ─────────────────────────

# URL interna al backend (usada por el servidor Next.js para llamar a la API).
# En Docker usa el nombre del servicio: http://api:8000
# Local sin Docker: http://localhost:8000
BACKEND_URL=http://localhost:8000

# API key para autenticarse con el backend.
# Debe coincidir con BACKEND_API_KEY del backend.
BACKEND_API_KEY=change-me

# Proxies para la consulta de AT&T (opcional).
# Formato (coma-separado): http://user:pass@host:port  o  host:port:user:pass
# Vacío = consulta directa (funciona desde IP residencial).
ATT_PROXIES=

# Firma de exportaciones (opcional). Vacío = no se firman.
EXPORT_SIGNING_SECRET=
EXPORT_SIGNING_KEY_ID=local-unsigned

# Puerto expuesto (host). El interno es siempre 3000.
WEB_PORT=3000
