# ── Build-time (se hornean en el bundle — requieren rebuild al cambiar) ────────

# URL pública del backend API. Se usa en páginas Server Component y API routes.
# Local: http://localhost:8000 · Producción: https://api.consultatulinea.mx
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cloudflare Turnstile — clave PÚBLICA del sitio (visible en el browser).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=change-me

# Token de verificación de Google Search Console (el valor del meta
# `google-site-verification`, sin la etiqueta). Vacío = no se emite la meta.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Runtime (solo servidor — nunca llegan al browser) ─────────────────────────

# URL interna al backend (usada por el servidor Next.js para llamar a la API).
# En producción apunta al hostname interno donde corre el backend.
# Local: http://localhost:8000
BACKEND_URL=http://localhost:8000

# API key para autenticarse con el backend.
# Debe coincidir con BACKEND_API_KEY del backend.
BACKEND_API_KEY=change-me

# ── Proxies de salida ─────────────────────────────────────────────────────────

# Tier 1 — proxy HTTP para proveedores que bloquean IPs de datacenter.
# Acepta cualquier proxy HTTP compatible (Privoxy, Squid, Tor+Privoxy, etc.).
# Vacío = sin proxy (conexión directa).
# Ejemplo: http://localhost:8118
PROVIDER_PROXY_URL=

# Tier 2 — proxy HTTP con IP residencial para proveedores que bloquean
# proxies de datacenter. Vacío = sin proxy; esos proveedores devuelven el
# portal oficial como fallback para consulta manual.
# Ejemplo: http://user:pass@proxy.example.com:8119
RESIDENTIAL_PROXY_URL=

# Reservado (no utilizado actualmente).
ATT_PROXIES=

# ── Caché de consultas en memoria ────────────────────────────────────────────

# Tiempo de vida de cada entrada de caché (ms). Por defecto 10 minutos.
# Aumentar reduce carga en proxies residenciales (facturados por GB);
# reducir da resultados más frescos. 0 = sin caché.
LOOKUP_CACHE_TTL_MS=600000

# Número máximo de entradas simultáneas en caché.
# Cada entrada ocupa ~1 KB de RAM. 5000 entradas ≈ 5 MB.
LOOKUP_CACHE_MAX_ENTRIES=5000

# ── Firma de exportaciones ────────────────────────────────────────────────────

# Clave secreta para firmar exportaciones PDF/CSV (opcional). Vacío = sin firma.
EXPORT_SIGNING_SECRET=
EXPORT_SIGNING_KEY_ID=local-unsigned

# ── Puerto ────────────────────────────────────────────────────────────────────

# Puerto expuesto al host. El puerto interno del contenedor es siempre 3000.
WEB_PORT=3000
