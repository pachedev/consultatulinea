# URL pública del backend API (noticias / estado / reportes).
# Local: http://localhost:8000 · Producción: https://api.consultatulinea.mx
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cloudflare Turnstile (clave pública del sitio). Se usa en el form de reportes.
# Dejar vacío en dev si aún no hay clave.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Proxies para la consulta de AT&T (opcional). En IPs de datacenter AT&T puede
# bloquear por reputación; con proxies se rota la salida y se reintenta.
# Formato (coma-separado): http://user:pass@host:port  o  host:port:user:pass
# Vacío = consulta directa (funciona desde IP residencial).
ATT_PROXIES=
